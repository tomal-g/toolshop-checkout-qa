    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "// 1. Assert status code\r",
                  "pm.test(\"Login returns 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Assert token exists in response\r",
                  "pm.test(\"Response contains access_token\", function () {\r",
                  "    pm.expect(response).to.have.property(\"access_token\");\r",
                  "    pm.expect(response.access_token).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "// 3. Extract token into environment variable\r",
                  "pm.environment.set(\"accessToken\", response.access_token);\r",
                  "\r",
                  "// 4. Confirm it was set\r",
                  "console.log(\"Token captured:\", pm.environment.get(\"accessToken\"));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"{{customerEmail}}\",\r\n    \"password\": \"{{customerPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            }
          },
          "response": []
        },
